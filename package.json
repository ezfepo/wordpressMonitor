    "wp:check-ssh": "node src/check-ssh.js",
    "gmail:auth": "node src/gmail-auth.js",
    "dmarc:fetch": "node src/dmarc-fetch.js",
    "wp:mails": "node src/wp-mails-fetch.js",
    "php:check": "node src/php-check.js",
    "dmarc:parse": "node src/parse-dmarc.js",
    "report": "node src/build-report.js"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
