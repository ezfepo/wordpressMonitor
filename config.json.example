{
  "retentionDays": 3,
  "gmail": {
    "labels": {
      "dmarc": "dmarc",
      "wordpress": "wordpress"
    },
    "auth": {
      "clientId": "",
      "clientSecret": "",
      "refreshToken": ""
    }
  },
  "hostinger": {
    "apiToken": ""
  },
  "security": {
    "allowedMuPlugins": [],
    "iocPatterns": ["wpsip", "sendinfo"],
    "spamKeywords": ["casino", "viagra", "cialis", "pharma"],
    "maxBackupAgeDays": 3,
    "tlsWarnDays": 14,
    "tlsAlertDays": 7,
    "domainWarnDays": 30,
    "domainAlertDays": 14,
    "dbScanMaxResults": 25,
    "dbScanAllowedDomains": [],
    "allowedTelegramPlugins": []
  },
  "dmarc": {
    "knownSources": [
      {
        "name": "Titan (mailboxes)",
        "match": ["flockmail.com", "titan.email"]
      },
      {
        "name": "Hostinger shared hosting (WordPress wp_mail via MailChannels)",
        "match": ["main-hosting.eu"]
      }
    ]
  }
}
